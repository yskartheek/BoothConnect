# BoothConnect environment template.
#
# Copy this file to `.env` in the repository root:
#   Copy-Item infra/env/.env.example .env        (PowerShell)
#   cp infra/env/.env.example .env               (bash)
#
# Every value below is a local-development default. None of them is a real
# secret. Never commit `.env`, and never reuse these values in a shared or
# production environment.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# PostgreSQL (docker-compose `postgres` service)
# ---------------------------------------------------------------------------

# Credentials and database the container creates on its first start.
# Changing them later requires `pnpm infra:reset` (this deletes local data).
POSTGRES_USER=boothconnect
POSTGRES_PASSWORD=boothconnect
POSTGRES_DB=boothconnect
# Port published on your machine. Change it if a local PostgreSQL uses 5432.
POSTGRES_PORT=5432

# Connection string the API and Prisma use. Must match the four values above.
DATABASE_URL=postgresql://boothconnect:boothconnect@localhost:5432/boothconnect?schema=public

# ---------------------------------------------------------------------------
# Redis (docker-compose `redis` service): background job queues
# ---------------------------------------------------------------------------

# Port published on your machine.
REDIS_PORT=6379
# Connection URL the API uses. Must match REDIS_PORT.
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Object storage: MinIO locally, any S3-compatible service elsewhere
# ---------------------------------------------------------------------------

# MinIO admin account, also used to sign in to the console
# (http://localhost:9001). Changing it later requires `pnpm infra:reset`.
MINIO_ROOT_USER=boothconnect
MINIO_ROOT_PASSWORD=boothconnect-dev-secret
# Ports published on your machine: S3 API and web console.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# S3 endpoint the API talks to. Must match MINIO_API_PORT.
S3_ENDPOINT=http://localhost:9000
# Region sent with S3 requests. MinIO accepts any value.
S3_REGION=us-east-1
# Access keys the API uses. Locally these are the MinIO admin account.
S3_ACCESS_KEY_ID=boothconnect
S3_SECRET_ACCESS_KEY=boothconnect-dev-secret
# MinIO needs path-style URLs (http://host/bucket/key).
S3_FORCE_PATH_STYLE=true
# Private bucket for uploaded voter-list import files. `pnpm infra:up`
# creates it.
S3_BUCKET_IMPORTS=boothconnect-imports
# Largest roll PDF and ZIP an admin may upload (bytes), and how long the
# presigned upload URLs work (seconds).
IMPORT_MAX_PDF_BYTES=104857600
IMPORT_MAX_ZIP_BYTES=2147483648
IMPORT_UPLOAD_URL_TTL_SECONDS=3600
# Where the API sends roll PDFs for extraction (must match the roll-parser's
# ROLL_PARSER_QUEUE / ROLL_PARSER_QUEUE_PREFIX), and how often (seconds) it
# checks for finished extractions it may have missed.
ROLL_PARSER_QUEUE=roll-extraction
ROLL_PARSER_QUEUE_PREFIX=bull
IMPORT_RESULTS_SWEEP_SECONDS=30

# ---------------------------------------------------------------------------
# roll-parser worker (apps/roll-parser): reads REDIS_URL and S3_* above.
# All settings: docs/design/roll-parser-contract.md, section 6.
# ---------------------------------------------------------------------------

# Roll PDFs processed at the same time, and the time limit for each one.
ROLL_PARSER_CONCURRENCY=1
ROLL_PARSER_TIMEOUT_SECONDS=600
# Port of the worker's /health endpoint.
ROLL_PARSER_HEALTH_PORT=8090

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------

# Port the API listens on (http://localhost:4000/v1).
API_PORT=4000
# Comma-separated browser origins allowed to call the API (the admin web app).
CORS_ORIGINS=http://localhost:3000
# Where the admin web calls the API (the typed client in packages/api-client).
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# Signing keys for access and refresh tokens (the refresh key also hashes
# stored refresh tokens and sign-in codes). Use two different random values of
# at least 32 characters outside local development, e.g.
# `openssl rand -base64 48`; the API refuses to start in production otherwise.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
# Access-token lifetime in seconds (900 = 15 minutes).
JWT_ACCESS_TTL_SECONDS=900
# Refresh-token lifetime in seconds (2592000 = 30 days). Refresh tokens rotate
# on every use.
JWT_REFRESH_TTL_SECONDS=2592000

# One-time sign-in code lifetime in seconds.
OTP_TTL_SECONDS=300
# true: no SMS is sent; the code is written to the API log so you can sign in
# locally. Must be false anywhere real people sign in (the API refuses to start
# in production with it on).
OTP_DEV_MODE=true
# Wrong codes allowed before a code is locked and a new one must be requested.
OTP_MAX_ATTEMPTS=5
# Code requests allowed per phone number in each window (seconds).
OTP_REQUEST_LIMIT=3
OTP_REQUEST_WINDOW_SECONDS=600
# How long a write's response is kept so a retry with the same Idempotency-Key
# gets it back instead of repeating the write (604800 = 7 days, enough for a
# phone that was offline for days to retry its queue).
IDEMPOTENCY_TTL_SECONDS=604800

# ---------------------------------------------------------------------------
# Privacy
# ---------------------------------------------------------------------------

# Smallest group size analytics may report. Smaller groups are suppressed so
# individual voters can't be identified.
ANALYTICS_MIN_COHORT=10
# Analytics (node_stats) are refreshed right after an import is confirmed;
# other changes (e.g. visits) are picked up within this many seconds.
ANALYTICS_REFRESH_SECONDS=30

# ---------------------------------------------------------------------------
# Admin web (apps/admin-web)
# ---------------------------------------------------------------------------

# Next.js reads these from its own environment (apps/admin-web/.env.local, or
# the host's settings), not from this file; they are listed here for reference.
#
# Where the admin web's server calls the API. The browser only talks to the
# admin web, which keeps the sign-in tokens in httpOnly cookies (#70).
# Default: http://localhost:4000. Must match API_PORT.
# API_URL=http://localhost:4000
#
# The admin MFA step is a placeholder that lets admins through in
# development. "allow" also lets them through on a production build: for
# test deployments only.
# ADMIN_MFA_STUB=
#
# Sign-in cookies are Secure on a production build. "false" allows a
# production build served over plain http (local testing only).
# COOKIE_SECURE=
