{
  "$description": "BoothConnect design tokens: the single source for the web CSS variables and the Flutter ThemeData. Sizes are logical pixels (px on web, dp/pt on mobile); durations are milliseconds. Colours are #RRGGBB, or rgba(r, g, b, a) where the token is translucent. Based on spec §11.1 and docs/design/volunteer-app-mockups.html.",
  "radius": {
    "small": 12,
    "medium": 18,
    "large": 24,
    "sheet": 28,
    "pill": 999
  },
  "spacing": {
    "xxs": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48
  },
  "touchTarget": {
    "ios": 44,
    "android": 48
  },
  "typography": {
    "fontFamily": {
      "display": ["Bricolage Grotesque", "Segoe UI", "system-ui", "sans-serif"],
      "ui": ["Figtree", "Segoe UI", "system-ui", "-apple-system", "sans-serif"],
      "mono": ["JetBrains Mono", "ui-monospace", "Consolas", "monospace"]
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "style": {
      "display": { "family": "display", "size": 26, "lineHeight": 32, "weight": "bold" },
      "headline": { "family": "display", "size": 20, "lineHeight": 26, "weight": "bold" },
      "title": { "family": "ui", "size": 17, "lineHeight": 24, "weight": "semibold" },
      "body": { "family": "ui", "size": 16, "lineHeight": 24, "weight": "regular" },
      "bodySmall": { "family": "ui", "size": 14, "lineHeight": 20, "weight": "regular" },
      "label": { "family": "ui", "size": 14, "lineHeight": 20, "weight": "semibold" },
      "caption": { "family": "ui", "size": 12, "lineHeight": 16, "weight": "medium" }
    }
  },
  "blur": {
    "glass": 20,
    "sheet": 28
  },
  "motion": {
    "duration": {
      "fast": 150,
      "standard": 220,
      "slow": 300
    },
    "easing": {
      "standard": [0.2, 0, 0, 1],
      "emphasized": [0.3, 0, 0, 1],
      "exit": [0.3, 0, 1, 1]
    },
    "spring": {
      "sheet": { "stiffness": 380, "damping": 34, "mass": 1 },
      "card": { "stiffness": 500, "damping": 38, "mass": 1 }
    },
    "reducedMotion": {
      "duration": 0
    }
  },
  "themes": {
    "light": {
      "color": {
        "background": "#F3F5FA",
        "backdropTintA": "#D6E0FF",
        "backdropTintB": "#CBEDEE",
        "surface": "#FFFFFF",
        "surfaceMuted": "#EEF1F7",
        "text": "#121A2B",
        "textMuted": "#56627A",
        "primary": "#2446B8",
        "onPrimary": "#FFFFFF",
        "primaryContainer": "#E3E8F7",
        "secondary": "#0A7880",
        "onSecondary": "#FFFFFF",
        "accent": "#9C5E00",
        "success": "#1B7A47",
        "successContainer": "#E1F0E7",
        "warning": "#8F5B00",
        "warningContainer": "#F8EDDC",
        "danger": "#B02A2A",
        "onDanger": "#FFFFFF",
        "dangerContainer": "#F8E5E5",
        "border": "#D3DAE6",
        "divider": "rgba(18, 26, 43, 0.11)",
        "focusRing": "#2446B8",
        "scrim": "rgba(10, 16, 32, 0.45)"
      },
      "glass": {
        "fill": "rgba(255, 255, 255, 0.62)",
        "border": "rgba(255, 255, 255, 0.55)",
        "highlight": "rgba(255, 255, 255, 0.72)"
      },
      "reducedTransparency": {
        "fill": "#F8F9FC",
        "border": "#D3DAE6",
        "highlight": "#FFFFFF"
      },
      "elevation": {
        "low": "0 1px 2px rgba(10, 16, 32, 0.08), 0 2px 8px -2px rgba(10, 16, 32, 0.10)",
        "medium": "0 8px 18px -8px rgba(10, 16, 32, 0.28)",
        "high": "0 18px 40px -12px rgba(10, 16, 32, 0.32)"
      }
    },
    "dark": {
      "color": {
        "background": "#0D1320",
        "backdropTintA": "#1B2A60",
        "backdropTintB": "#0D3C42",
        "surface": "#161D2B",
        "surfaceMuted": "#1D2638",
        "text": "#EAF0FA",
        "textMuted": "#A5B0C6",
        "primary": "#8AA2FF",
        "onPrimary": "#0A1024",
        "primaryContainer": "#232C4A",
        "secondary": "#55C6CD",
        "onSecondary": "#0A1024",
        "accent": "#F2AB45",
        "success": "#62CF90",
        "successContainer": "#1D3334",
        "warning": "#F2B75A",
        "warningContainer": "#35302A",
        "danger": "#FF8484",
        "onDanger": "#0A1024",
        "dangerContainer": "#3A2530",
        "border": "#2E3850",
        "divider": "rgba(255, 255, 255, 0.10)",
        "focusRing": "#8AA2FF",
        "scrim": "rgba(0, 0, 0, 0.55)"
      },
      "glass": {
        "fill": "rgba(22, 27, 36, 0.68)",
        "border": "rgba(255, 255, 255, 0.14)",
        "highlight": "rgba(255, 255, 255, 0.10)"
      },
      "reducedTransparency": {
        "fill": "#161D2B",
        "border": "#2E3850",
        "highlight": "#1D2638"
      },
      "elevation": {
        "low": "0 1px 2px rgba(0, 0, 0, 0.40), 0 2px 8px -2px rgba(0, 0, 0, 0.45)",
        "medium": "0 8px 18px -8px rgba(0, 0, 0, 0.60)",
        "high": "0 18px 40px -12px rgba(0, 0, 0, 0.70)"
      }
    }
  },
  "contrast": {
    "$description": "Pairs the contrast check tests in every theme. Paths are relative to the theme. A translucent background is tested composited over each backdrop colour, and the worst result counts. Text needs 4.5:1 (WCAG 1.4.3); focus rings and control boundaries need 3:1 (WCAG 1.4.11).",
    "backdrops": ["color.background", "color.backdropTintA", "color.backdropTintB"],
    "pairs": [
      {
        "foreground": ["color.text", "color.textMuted", "color.primary"],
        "background": [
          "color.background",
          "color.surface",
          "color.surfaceMuted",
          "glass.fill",
          "reducedTransparency.fill"
        ],
        "min": 4.5
      },
      {
        "foreground": [
          "color.secondary",
          "color.accent",
          "color.success",
          "color.warning",
          "color.danger"
        ],
        "background": [
          "color.background",
          "color.surface",
          "glass.fill",
          "reducedTransparency.fill"
        ],
        "min": 4.5
      },
      { "foreground": ["color.onPrimary"], "background": ["color.primary"], "min": 4.5 },
      { "foreground": ["color.onSecondary"], "background": ["color.secondary"], "min": 4.5 },
      { "foreground": ["color.onDanger"], "background": ["color.danger"], "min": 4.5 },
      {
        "foreground": ["color.text", "color.primary"],
        "background": ["color.primaryContainer"],
        "min": 4.5
      },
      {
        "foreground": ["color.text", "color.success"],
        "background": ["color.successContainer"],
        "min": 4.5
      },
      {
        "foreground": ["color.text", "color.warning"],
        "background": ["color.warningContainer"],
        "min": 4.5
      },
      {
        "foreground": ["color.text", "color.danger"],
        "background": ["color.dangerContainer"],
        "min": 4.5
      },
      {
        "foreground": ["color.focusRing", "color.primary"],
        "background": [
          "color.background",
          "color.surface",
          "color.surfaceMuted",
          "glass.fill",
          "reducedTransparency.fill"
        ],
        "min": 3
      }
    ]
  }
}
