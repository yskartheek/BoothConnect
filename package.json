{
  "name": "boothconnect",
  "private": true,
  "description": "BoothConnect voter field-operations platform (monorepo)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "node scripts/infra.mjs up",
    "infra:down": "node scripts/infra.mjs down",
    "infra:logs": "node scripts/infra.mjs logs",
    "infra:reset": "node scripts/infra.mjs reset"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.5.0"
  }
}
