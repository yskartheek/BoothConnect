// BoothConnect database schema. Conventions (see apps/api/README.md):
// - IDs: UUIDv7, generated by Prisma in the app: `id String @id @default(uuid(7)) @db.Uuid`
// - Timestamps: `DateTime @db.Timestamptz`, always stored in UTC
// - Table and column names: snake_case via @@map / @map; model and field names: PascalCase / camelCase

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  runtime         = "nodejs"
  // Partial unique indexes (e.g. top-level geography codes); generally available in Prisma 8.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Organization and election program
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  active
  suspended

  @@map("organization_status")
}

model Organization {
  id              String             @id @default(uuid(7)) @db.Uuid
  name            String
  status          OrganizationStatus @default(active)
  defaultLanguage String             @default("en") @map("default_language")
  /// Organization-wide policy settings (e.g. analytics threshold); validated by the API.
  policyConfig    Json               @default("{}") @map("policy_config")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  programs ElectionProgram[]
  users    AppUser[]

  @@map("organization")
}

enum ElectionProgramType {
  general_election
  by_election
  local_body_election
  campaign

  @@map("election_program_type")
}

enum ElectionProgramStatus {
  draft
  active
  closed
  archived

  @@map("election_program_status")
}

model ElectionProgram {
  id             String                @id @default(uuid(7)) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  name           String
  type           ElectionProgramType
  startDate      DateTime?             @map("start_date") @db.Date
  endDate        DateTime?             @map("end_date") @db.Date
  status         ElectionProgramStatus @default(draft)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  geographyNodes   GeographyNode[]
  sourceVersions   SourceVersion[]
  importBatches    ImportBatch[]
  importFiles      ImportFile[]
  voters           Voter[]
  fieldDefinitions FieldDefinition[]

  @@index([organizationId])
  @@map("election_program")
}

// ---------------------------------------------------------------------------
// Geography: State → PC → AC → Part → Polling Station
// (docs/design/voter-roll-pdf-import.md §2)
//
// Enforced by triggers in the migration SQL (Prisma can't express them):
// - a node's parent must be of the level directly above it (roots are states)
// - parent, type and program can't change after insert
// - geography_closure is filled automatically on insert
// ---------------------------------------------------------------------------

enum GeographyNodeType {
  state
  pc
  ac
  part
  polling_station

  @@map("geography_node_type")
}

model GeographyNode {
  id          String            @id @default(uuid(7)) @db.Uuid
  programId   String            @map("program_id") @db.Uuid
  parentId    String?           @map("parent_id") @db.Uuid
  type        GeographyNodeType
  /// Official number: state code (S29), PC 6, AC 40, part 408, auxiliary station 408A.
  code        String
  name        String
  /// Only for polling stations: an auxiliary station splitting its part.
  isAuxiliary Boolean           @default(false) @map("is_auxiliary")
  /// Reservation status, names by language; parts: sections, town, mandal, district, PIN;
  /// stations: address, station type, and for auxiliary stations the sections or serial range covered.
  metadata    Json              @default("{}")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  program             ElectionProgram    @relation(fields: [programId], references: [id], onDelete: Restrict)
  parent              GeographyNode?     @relation("GeographyTree", fields: [parentId], references: [id], onDelete: Restrict)
  children            GeographyNode[]    @relation("GeographyTree")
  ancestors           GeographyClosure[] @relation("ClosureDescendant")
  descendants         GeographyClosure[] @relation("ClosureAncestor")
  roleAssignments     RoleAssignment[]
  sourceVersions      SourceVersion[]
  importBatches       ImportBatch[]
  importFiles         ImportFile[]
  householdsInPart    Household[]        @relation("HouseholdPart")
  householdsAtStation Household[]        @relation("HouseholdStation")
  votersInPart        Voter[]            @relation("VoterPart")
  votersAtStation     Voter[]            @relation("VoterStation")
  stats               NodeStats?
  statsRequest        NodeStatsRequest?

  @@unique([programId, parentId, code], map: "geography_node_sibling_code_key")
  // Top-level states have no parent, and NULLs never collide in a normal unique index.
  @@unique([programId, code], map: "geography_node_root_code_key", where: { parentId: null })
  @@index([parentId])
  @@index([programId, type])
  @@map("geography_node")
}

/// Every (ancestor, descendant) pair, including each node with itself at depth 0.
/// "All polling stations under AC 40" and "all ancestors of a station" are single queries.
model GeographyClosure {
  ancestorId   String @map("ancestor_id") @db.Uuid
  descendantId String @map("descendant_id") @db.Uuid
  depth        Int

  ancestor   GeographyNode @relation("ClosureAncestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant GeographyNode @relation("ClosureDescendant", fields: [descendantId], references: [id], onDelete: Cascade)

  @@id([ancestorId, descendantId])
  @@index([descendantId, depth])
  @@map("geography_closure")
}

// ---------------------------------------------------------------------------
// Users, sessions and role assignments
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  /// Loses access to every protected API immediately (spec §7.1).
  suspended

  @@map("user_status")
}

enum MfaState {
  /// MFA not set up. Admins and campaign managers must enrol before touching personal data.
  not_enrolled
  enrolled

  @@map("mfa_state")
}

model AppUser {
  id                String     @id @default(uuid(7)) @db.Uuid
  organizationId    String     @map("organization_id") @db.Uuid
  name              String
  /// E.164 format, e.g. +919876543210. Used for OTP sign-in, so unique.
  phone             String     @unique
  /// Stored lower-case.
  email             String?    @unique
  status            UserStatus @default(active)
  preferredLanguage String     @default("en") @map("preferred_language")
  mfaState          MfaState   @default(not_enrolled) @map("mfa_state")
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessions           Session[]
  roleAssignments    RoleAssignment[]    @relation("AssignedUser")
  grantedRoles       RoleAssignment[]    @relation("GrantedBy")
  uploadedBatches    ImportBatch[]       @relation("BatchUploadedBy")
  confirmedBatches   ImportBatch[]       @relation("BatchConfirmedBy")
  confirmedFiles     ImportFile[]        @relation("FileConfirmedBy")
  importUploads      ImportUpload[]      @relation("UploadCreatedBy")
  correctedRows      ImportRowResult[]
  collectedValues    FieldValue[]
  visits             Visit[]
  capturedConsents   Consent[]           @relation("ConsentCapturedBy")
  withdrawnConsents  Consent[]           @relation("ConsentWithdrawnBy")
  idempotencyRecords IdempotencyRecord[]
  auditEvents        AuditEvent[]

  @@index([organizationId])
  @@map("app_user")
}

/// One signed-in device. Refresh tokens rotate on every use (plan §2): only the
/// hash of the current one is stored.
model Session {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  deviceId    String    @map("device_id")
  /// SHA-256 of the current refresh token.
  refreshHash String    @unique @map("refresh_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// Set for a voter's session (#223): it acts for this voter record only,
  /// with no staff role or booth, whoever else the phone's user is.
  voterId     String?   @map("voter_id") @db.Uuid

  user        AppUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  voter       Voter?       @relation(fields: [voterId], references: [id], onDelete: Restrict)
  auditEvents AuditEvent[]

  @@index([userId])
  @@index([voterId])
  @@map("session")
}

enum Role {
  admin
  campaign_manager
  volunteer
  voter

  @@map("role")
}

/// A role on a geography node (and everything below it) for a time window.
/// Active at time T: valid_from <= T and (valid_until is null or valid_until > T).
model RoleAssignment {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  role            Role
  geographyNodeId String    @map("geography_node_id") @db.Uuid
  validFrom       DateTime  @default(now()) @map("valid_from") @db.Timestamptz
  validUntil      DateTime? @map("valid_until") @db.Timestamptz
  /// Null only for assignments created by the seed or bootstrap scripts.
  grantedById     String?   @map("granted_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user          AppUser       @relation("AssignedUser", fields: [userId], references: [id], onDelete: Cascade)
  geographyNode GeographyNode @relation(fields: [geographyNodeId], references: [id], onDelete: Restrict)
  grantedBy     AppUser?      @relation("GrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([userId, validFrom])
  @@index([geographyNodeId])
  @@map("role_assignment")
}

// ---------------------------------------------------------------------------
// Electoral-roll imports (docs/design/voter-roll-pdf-import.md §3–§5)
// ---------------------------------------------------------------------------

/// One published revision of one part's roll. A newer revision of the same part
/// is a new row; older ones are kept for audit and comparison.
model SourceVersion {
  id                 String    @id @default(uuid(7)) @db.Uuid
  programId          String    @map("program_id") @db.Uuid
  /// Always a `part` node (checked by a trigger).
  partNodeId         String    @map("part_node_id") @db.Uuid
  /// e.g. 2026
  revisionYear       Int       @map("revision_year")
  /// e.g. "Special Intensive Revision 2026"
  revisionType       String    @map("revision_type")
  /// e.g. "Draft Electoral Roll of Special Intensive Revision, 2026"
  rollIdentification String    @map("roll_identification")
  qualifyingDate     DateTime? @map("qualifying_date") @db.Date
  publishedOn        DateTime? @map("published_on") @db.Date
  /// SHA-256 of the PDF it came from.
  checksum           String
  /// The revision of this part that this one replaces, if any.
  previousVersionId  String?   @unique @map("previous_version_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  program         ElectionProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  partNode        GeographyNode   @relation(fields: [partNodeId], references: [id], onDelete: Restrict)
  previousVersion SourceVersion?  @relation("SourceVersionHistory", fields: [previousVersionId], references: [id], onDelete: Restrict)
  nextVersion     SourceVersion?  @relation("SourceVersionHistory")
  importFile      ImportFile?
  households      Household[]
  voters          Voter[]

  @@unique([partNodeId, checksum])
  @@index([programId])
  @@map("source_version")
}

enum ImportBatchStatus {
  /// Files are being uploaded.
  uploading
  /// At least one file is still being extracted.
  processing
  /// Extraction finished; files wait for review or confirmation.
  review
  /// Every file is confirmed, rejected, duplicate or failed.
  completed
  cancelled

  @@map("import_batch_status")
}

/// One upload session at a chosen hierarchy level (State, PC, AC or Part).
model ImportBatch {
  id            String            @id @default(uuid(7)) @db.Uuid
  programId     String            @map("program_id") @db.Uuid
  /// The level the admin picked; every file's part must be under it.
  targetNodeId  String            @map("target_node_id") @db.Uuid
  uploadedById  String            @map("uploaded_by") @db.Uuid
  status        ImportBatchStatus @default(uploading)
  fileCount     Int               @default(0) @map("file_count")
  confirmedById String?           @map("confirmed_by") @db.Uuid
  confirmedAt   DateTime?         @map("confirmed_at") @db.Timestamptz
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  program     ElectionProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  targetNode  GeographyNode   @relation(fields: [targetNodeId], references: [id], onDelete: Restrict)
  uploadedBy  AppUser         @relation("BatchUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  confirmedBy AppUser?        @relation("BatchConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  files       ImportFile[]
  uploads     ImportUpload[]

  @@index([programId, createdAt])
  @@index([targetNodeId])
  @@map("import_batch")
}

enum ImportFileStatus {
  uploaded
  extracting
  /// Extracted, but the totals don't match or confidence is low.
  needs_review
  ready
  /// Confirmed by an admin; waiting for its rows to be committed (#47).
  confirming
  confirmed
  /// The PDF's header is outside the batch's target node, or it isn't a roll.
  rejected
  /// Same checksum as a file already imported (or being imported).
  duplicate
  failed

  @@map("import_file_status")
}

enum ExtractionMethod {
  text
  ocr

  @@map("extraction_method")
}

enum ImportUploadKind {
  pdf
  zip

  @@map("import_upload_kind")
}

enum ImportUploadStatus {
  /// Upload URLs handed out; the browser is uploading.
  pending
  /// Verified and turned into import_file rows.
  completed
  /// Size or content didn't check out; nothing was imported.
  failed

  @@map("import_upload_status")
}

/// One object the admin uploads into a batch: a roll PDF, or a ZIP of PDFs
/// that becomes one import_file per PDF when completed (#44).
model ImportUpload {
  id           String             @id @default(uuid(7)) @db.Uuid
  batchId      String             @map("batch_id") @db.Uuid
  kind         ImportUploadKind
  /// Object key in the private import bucket.
  objectKey    String             @unique @map("object_key")
  originalName String             @map("original_name")
  /// Declared when the upload started; checked against the stored object.
  sizeBytes    BigInt             @map("size_bytes")
  /// The S3 multipart upload the browser sends parts to.
  s3UploadId   String             @map("s3_upload_id")
  status       ImportUploadStatus @default(pending)
  /// Why it failed.
  error        Json?
  createdById  String             @map("created_by") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz
  completedAt  DateTime?          @map("completed_at") @db.Timestamptz

  batch     ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdBy AppUser      @relation("UploadCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  files     ImportFile[]

  @@index([batchId, status])
  @@map("import_upload")
}

/// One roll PDF (one part) inside a batch.
model ImportFile {
  id               String            @id @default(uuid(7)) @db.Uuid
  batchId          String            @map("batch_id") @db.Uuid
  /// The upload it came from (the PDF itself, or the ZIP it was in).
  uploadId         String?           @map("upload_id") @db.Uuid
  /// Denormalised from the batch so duplicate checks can be a unique index.
  programId        String            @map("program_id") @db.Uuid
  /// Object key in the private import bucket.
  fileRef          String            @map("file_ref")
  originalName     String            @map("original_name")
  sizeBytes        BigInt            @map("size_bytes")
  /// SHA-256 of the file, hex.
  checksum         String
  status           ImportFileStatus  @default(uploaded)
  duplicateOfId    String?           @map("duplicate_of_id") @db.Uuid
  pageCount        Int?              @map("page_count")
  /// Cover-page header as extracted (state, PC, AC, part, stations, revision…).
  detectedHeader   Json?             @map("detected_header")
  /// The part this file belongs to, once matched (always a `part` node).
  partNodeId       String?           @map("part_node_id") @db.Uuid
  sourceVersionId  String?           @unique @map("source_version_id") @db.Uuid
  extractionMethod ExtractionMethod? @map("extraction_method")
  /// 0–1, from field confidence and the totals check.
  qualityScore     Float?            @map("quality_score")
  printedTotals    Json?             @map("printed_totals")
  extractedTotals  Json?             @map("extracted_totals")
  /// Why the file was rejected or failed.
  error            Json?
  extractedAt      DateTime?         @map("extracted_at") @db.Timestamptz
  confirmedAt      DateTime?         @map("confirmed_at") @db.Timestamptz
  /// Who confirmed it (null for files confirmed before #47, e.g. the seed).
  confirmedById    String?           @map("confirmed_by") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  batch         ImportBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  upload        ImportUpload?     @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  program       ElectionProgram   @relation(fields: [programId], references: [id], onDelete: Restrict)
  duplicateOf   ImportFile?       @relation("DuplicateOf", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    ImportFile[]      @relation("DuplicateOf")
  partNode      GeographyNode?    @relation(fields: [partNodeId], references: [id], onDelete: Restrict)
  sourceVersion SourceVersion?    @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)
  confirmedBy   AppUser?          @relation("FileConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  rows          ImportRowResult[]
  voters        Voter[]

  /// A file can only be live once per program; duplicates, rejected and failed
  /// uploads keep their row (with the same checksum) for the record.
  /// The condition is written the way PostgreSQL normalises `status NOT IN (...)`,
  /// otherwise Prisma reports drift on every migrate.
  @@unique([programId, checksum], map: "import_file_live_checksum_key", where: raw("(status <> ALL (ARRAY['duplicate'::import_file_status, 'rejected'::import_file_status, 'failed'::import_file_status]))"))
  @@index([batchId, status])
  @@index([partNodeId])
  @@map("import_file")
}

enum ImportRowStatus {
  accepted
  warning
  rejected

  @@map("import_row_status")
}

/// One voter box extracted from a roll page, before it becomes a voter.
model ImportRowResult {
  id              String          @id @default(uuid(7)) @db.Uuid
  importFileId    String          @map("import_file_id") @db.Uuid
  page            Int
  /// Position on the page, 0-based in reading order.
  boxIndex        Int             @map("box_index")
  sectionNo       Int?            @map("section_no")
  serialNo        Int?            @map("serial_no")
  status          ImportRowStatus
  /// Validation messages: [{ code, field, message }]
  messages        Json            @default("[]")
  /// OCR text of the box, kept for audit and correction.
  rawText         String?         @map("raw_text")
  /// Parsed fields: epic, name, relationType, relativeName, houseNumber, age, gender, deleted.
  extractedValues Json            @map("extracted_values")
  /// 0–1 per field.
  fieldConfidence Json            @default("{}") @map("field_confidence")
  /// Admin corrections, applied on top of extracted_values at confirm time.
  correctedValues Json?           @map("corrected_values")
  correctedById   String?         @map("corrected_by") @db.Uuid
  correctedAt     DateTime?       @map("corrected_at") @db.Timestamptz

  importFile  ImportFile @relation(fields: [importFileId], references: [id], onDelete: Cascade)
  correctedBy AppUser?   @relation(fields: [correctedById], references: [id], onDelete: Restrict)

  @@unique([importFileId, page, boxIndex])
  @@index([importFileId, status])
  @@index([importFileId, sectionNo, serialNo])
  @@map("import_row_result")
}

// ---------------------------------------------------------------------------
// Households and voters
// ---------------------------------------------------------------------------

enum HouseholdStatus {
  active
  /// No voter in the latest revision of the part lists this house any more.
  removed

  @@map("household_status")
}

/// Where a household or member came from (spec v1.1).
enum RecordOrigin {
  official_import
  /// Added by a volunteer in the field; has no official roll entry.
  volunteer_added

  @@map("record_origin")
}

/// A house in a part: grouped from the roll's house numbers, or added by a
/// volunteer. Households outlive roll revisions, so visits and notes stay
/// attached when a new revision arrives.
model Household {
  id                 String          @id @default(uuid(7)) @db.Uuid
  partId             String          @map("part_id") @db.Uuid
  /// The station most of its voters vote at (main or auxiliary).
  pollingStationId   String          @map("polling_station_id") @db.Uuid
  /// House number normalised for grouping, e.g. "H NO 16-64" → "16-64".
  houseKey           String          @map("house_key")
  /// House number as printed in the roll, or as entered by the volunteer.
  displayAddress     String          @map("display_address")
  /// { house_no, street, area, pin_code, landmark }; volunteers can edit it.
  structuredAddress  Json            @default("{}") @map("structured_address")
  /// One-tap location from the volunteer's phone, only with consent.
  locationLat        Decimal?        @map("location_lat") @db.Decimal(9, 6)
  locationLng        Decimal?        @map("location_lng") @db.Decimal(9, 6)
  locationAccuracyM  Float?          @map("location_accuracy_m")
  locationCapturedAt DateTime?       @map("location_captured_at") @db.Timestamptz
  /// Consent record for the location (purpose `household_location`).
  locationConsentId  String?         @map("location_consent_id") @db.Uuid
  origin             RecordOrigin    @default(official_import)
  /// The latest revision that listed this house; null for volunteer-added houses.
  sourceVersionId    String?         @map("source_version_id") @db.Uuid
  status             HouseholdStatus @default(active)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  /// Sync change marker: the ID of the transaction that last wrote the row
  /// (set by the database; see GET /v1/sync/pull).
  changeXid          BigInt          @default(dbgenerated("((pg_current_xact_id())::text)::bigint")) @map("change_xid")

  part            GeographyNode  @relation("HouseholdPart", fields: [partId], references: [id], onDelete: Restrict)
  pollingStation  GeographyNode  @relation("HouseholdStation", fields: [pollingStationId], references: [id], onDelete: Restrict)
  sourceVersion   SourceVersion? @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)
  voters          Voter[]
  visits          Visit[]
  consents        Consent[]
  locationConsent Consent?       @relation("HouseholdLocationConsent", fields: [locationConsentId], references: [id], onDelete: Restrict)

  @@unique([partId, houseKey])
  @@index([pollingStationId, status])
  @@index([pollingStationId, changeXid])
  @@map("household")
}

enum VoterRecordStatus {
  active
  /// A newer revision of the part replaced this row.
  superseded
  /// Marked deleted in the roll, or removed by a later revision.
  deleted

  @@map("voter_record_status")
}

/// A household member: either one elector as printed in one revision of a
/// part's roll (origin official_import), or a member added by a volunteer.
/// For imported members `source_data` is the official record and never changes
/// (a trigger enforces it). Everyone's editable details (name, age, mobile, …)
/// live in field_value as current values with history (spec v1.1, #23).
model Voter {
  id               String            @id @default(uuid(7)) @db.Uuid
  programId        String            @map("program_id") @db.Uuid
  householdId      String            @map("household_id") @db.Uuid
  partId           String            @map("part_id") @db.Uuid
  pollingStationId String            @map("polling_station_id") @db.Uuid
  origin           RecordOrigin      @default(official_import)
  /// Official members only (checked): position in the roll.
  sectionNo        Int?              @map("section_no")
  serialNo         Int?              @map("serial_no")
  /// EPIC number, e.g. XIZ5458518. Official members always have one.
  sourceVoterId    String?           @map("source_voter_id")
  /// Official members only: as printed (name, relationType, relativeName, houseNumber, age, gender, rawText).
  sourceData       Json?             @map("source_data")
  sourceVersionId  String?           @map("source_version_id") @db.Uuid
  importFileId     String?           @map("import_file_id") @db.Uuid
  recordStatus     VoterRecordStatus @default(active) @map("record_status")
  /// The same voter (same EPIC) in the revision this one replaced (#161): the
  /// volunteer data carried over came from there, and visits follow the link.
  previousVoterId  String?           @unique @map("previous_voter_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  /// Sync change marker: the ID of the transaction that last wrote the row
  /// (set by the database; see GET /v1/sync/pull).
  changeXid        BigInt            @default(dbgenerated("((pg_current_xact_id())::text)::bigint")) @map("change_xid")

  program        ElectionProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  household      Household       @relation(fields: [householdId], references: [id], onDelete: Restrict)
  part           GeographyNode   @relation("VoterPart", fields: [partId], references: [id], onDelete: Restrict)
  pollingStation GeographyNode   @relation("VoterStation", fields: [pollingStationId], references: [id], onDelete: Restrict)
  sourceVersion  SourceVersion?  @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)
  importFile     ImportFile?     @relation(fields: [importFileId], references: [id], onDelete: Restrict)
  sessions       Session[]
  previousVoter  Voter?          @relation("VoterRevisions", fields: [previousVoterId], references: [id], onDelete: Restrict)
  nextVoter      Voter?          @relation("VoterRevisions")
  visitsMet      VisitMember[]
  consents       Consent[]

  @@unique([programId, sourceVersionId, sourceVoterId])
  @@unique([partId, sourceVersionId, serialNo])
  @@index([pollingStationId, recordStatus])
  @@index([partId, recordStatus])
  @@index([householdId])
  @@index([programId, sourceVoterId])
  @@index([pollingStationId, changeXid])
  @@map("voter")
}

// ---------------------------------------------------------------------------
// Configurable fields and their values (spec §7.3, plan §3)
// ---------------------------------------------------------------------------

enum FieldType {
  text
  number
  boolean
  date
  phone
  single_select
  multi_select
  /// Household address: { house_no, street, area, pin_code, landmark }.
  address
  /// Household location: { lat, lng, accuracyM, capturedAt }; needs consent.
  location

  @@map("field_type")
}

enum FieldEntity {
  voter
  household

  @@map("field_entity")
}

/// A field that can be collected for voters or households. Restricted fields
/// (caste/community, religion, political affiliation, precise location) are
/// disabled by default; enabling one needs consent and a documented legal basis.
model FieldDefinition {
  id              String      @id @default(uuid(7)) @db.Uuid
  programId       String      @map("program_id") @db.Uuid
  /// Stable key used by the apps, e.g. "mobile_number", "preferred_language".
  key             String
  /// i18n key for the label shown in the apps.
  labelKey        String      @map("label_key")
  appliesTo       FieldEntity @map("applies_to")
  type            FieldType
  /// Allowed values for select fields: [{ value, labelKey }].
  options         Json?
  isRestricted    Boolean     @default(false) @map("is_restricted")
  enabled         Boolean     @default(false)
  requiresConsent Boolean     @default(false) @map("requires_consent")
  /// Why the field is collected; shown in the collection notice.
  purpose         String
  /// Required before a restricted field can be enabled.
  legalBasis      String?     @map("legal_basis")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  /// Sync change marker: the ID of the transaction that last wrote the row
  /// (set by the database; see GET /v1/sync/pull).
  changeXid       BigInt      @default(dbgenerated("((pg_current_xact_id())::text)::bigint")) @map("change_xid")

  program ElectionProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  values  FieldValue[]

  @@unique([programId, key])
  @@index([programId, changeXid])
  @@map("field_definition")
}

enum ValueSource {
  official_import
  voter_self_submitted
  volunteer_collected
  admin_corrected
  derived

  @@map("value_source")
}

/// One value of one field for one voter or household. Volunteer edits become the
/// current value immediately (spec v1.1, ADR-0003). Append-only: a change is a
/// new row whose supersedes_id points at the value it replaces, so the full
/// history (and who changed what) is kept. is_current is maintained by a trigger.
model FieldValue {
  id                String      @id @default(uuid(7)) @db.Uuid
  entityType        FieldEntity @map("entity_type")
  /// A voter or household id, depending on entity_type.
  entityId          String      @map("entity_id") @db.Uuid
  fieldDefinitionId String      @map("field_definition_id") @db.Uuid
  value             Json
  sourceType        ValueSource @map("source_type")
  /// The consent record covering this value (required for consent fields).
  consentId         String?     @map("consent_id") @db.Uuid
  collectedById     String?     @map("collected_by") @db.Uuid
  collectedAt       DateTime    @default(now()) @map("collected_at") @db.Timestamptz
  /// The value this one replaces.
  supersedesId      String?     @unique @map("supersedes_id") @db.Uuid
  /// The value the client last saw when it made this change (conflict detection).
  baseVersion       String?     @map("base_version") @db.Uuid
  /// False once another value supersedes this one.
  isCurrent         Boolean     @default(true) @map("is_current")
  /// A copy of this value on the voter's previous record, made when a new
  /// revision replaced it (#161).
  carriedFromId     String?     @unique @map("carried_from_id") @db.Uuid
  /// Set when two offline edits of the same field collide: the value this one
  /// conflicts with. Cleared when the volunteer chooses which value to keep.
  conflictWithId    String?     @map("conflict_with_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz
  /// Sync change marker: the ID of the transaction that last wrote the row
  /// (set by the database; see GET /v1/sync/pull).
  changeXid         BigInt      @default(dbgenerated("((pg_current_xact_id())::text)::bigint")) @map("change_xid")

  fieldDefinition FieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Restrict)
  collectedBy     AppUser?        @relation(fields: [collectedById], references: [id], onDelete: Restrict)
  consent         Consent?        @relation(fields: [consentId], references: [id], onDelete: Restrict)
  supersedes      FieldValue?     @relation("FieldValueHistory", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy    FieldValue?     @relation("FieldValueHistory")
  conflictWith    FieldValue?     @relation("FieldValueConflict", fields: [conflictWithId], references: [id], onDelete: Restrict)
  conflictsWithMe FieldValue[]    @relation("FieldValueConflict")
  carriedFrom     FieldValue?     @relation("FieldValueCarryOver", fields: [carriedFromId], references: [id], onDelete: Restrict)
  carriedTo       FieldValue?     @relation("FieldValueCarryOver")

  /// "Current value(s) for each (entity, field)". Usually one; two edits that
  /// conflict are both current until the volunteer chooses one.
  @@index([entityType, entityId, fieldDefinitionId], map: "field_value_current_idx", where: raw("is_current"))
  @@index([fieldDefinitionId])
  @@index([conflictWithId])
  @@index([changeXid])
  @@map("field_value")
}

// ---------------------------------------------------------------------------
// Visits and consent (spec §7.4, v1.1)
// ---------------------------------------------------------------------------

enum VisitOutcome {
  completed
  partially_completed
  no_one_available
  refused
  address_not_found
  household_moved
  /// Subject to approved handling; never changes the official roll.
  voter_deceased
  duplicate_or_incorrect_listing
  follow_up_requested
  unsafe_or_inaccessible

  @@map("visit_outcome")
}

/// One household visit by a volunteer. Visits are immutable: a mistake is fixed
/// by a new visit whose corrects_visit_id points at the wrong one (audited in #34).
model Visit {
  id              String       @id @default(uuid(7)) @db.Uuid
  householdId     String       @map("household_id") @db.Uuid
  volunteerId     String       @map("volunteer_id") @db.Uuid
  startedAt       DateTime     @map("started_at") @db.Timestamptz
  completedAt     DateTime?    @map("completed_at") @db.Timestamptz
  outcome         VisitOutcome
  /// Version of the visit form the app used, e.g. "2026.1".
  formVersion     String       @map("form_version")
  /// Generated on the phone; a repeated upload of the same visit is recognised by it.
  clientId        String       @unique @map("client_id") @db.Uuid
  /// Free text; the app warns against entering sensitive information.
  notes           String?
  correctsVisitId String?      @unique @map("corrects_visit_id") @db.Uuid
  /// When the server received it (the phone may have been offline).
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  /// Sync change marker: the ID of the transaction that last wrote the row
  /// (set by the database; see GET /v1/sync/pull).
  changeXid       BigInt       @default(dbgenerated("((pg_current_xact_id())::text)::bigint")) @map("change_xid")

  household     Household     @relation(fields: [householdId], references: [id], onDelete: Restrict)
  volunteer     AppUser       @relation(fields: [volunteerId], references: [id], onDelete: Restrict)
  correctsVisit Visit?        @relation("VisitCorrection", fields: [correctsVisitId], references: [id], onDelete: Restrict)
  correctedBy   Visit?        @relation("VisitCorrection")
  membersMet    VisitMember[]

  @@index([householdId, startedAt])
  @@index([volunteerId, startedAt])
  @@index([householdId, changeXid])
  @@map("visit")
}

/// The household members the volunteer met during a visit (spec v1.1).
model VisitMember {
  visitId String @map("visit_id") @db.Uuid
  voterId String @map("voter_id") @db.Uuid

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Restrict)
  voter Voter @relation(fields: [voterId], references: [id], onDelete: Restrict)

  @@id([visitId, voterId])
  @@index([voterId])
  @@map("visit_member")
}

enum ConsentStatus {
  granted
  withdrawn

  @@map("consent_status")
}

enum ConsentMethod {
  /// Given to a volunteer in person, after the notice was read out or shown.
  in_person_verbal
  in_person_signed
  /// Given by the voter in the voter app.
  self_service

  @@map("consent_method")
}

/// Consent from a household member (or, for the household location, the
/// household) for one purpose. Withdrawal is recorded, never deleted; consent
/// given again later is a new record.
model Consent {
  id                 String        @id @default(uuid(7)) @db.Uuid
  /// Exactly one of the two subjects is set.
  subjectVoterId     String?       @map("subject_voter_id") @db.Uuid
  subjectHouseholdId String?       @map("subject_household_id") @db.Uuid
  /// A field key (e.g. "caste_community") or "household_location".
  purpose            String
  /// Version of the notice shown when consent was given.
  noticeVersion      String        @map("notice_version")
  status             ConsentStatus @default(granted)
  capturedMethod     ConsentMethod @map("captured_method")
  capturedById       String?       @map("captured_by") @db.Uuid
  capturedAt         DateTime      @default(now()) @map("captured_at") @db.Timestamptz
  withdrawnAt        DateTime?     @map("withdrawn_at") @db.Timestamptz
  withdrawnById      String?       @map("withdrawn_by") @db.Uuid
  /// Sync change marker: the ID of the transaction that last wrote the row
  /// (set by the database; see GET /v1/sync/pull).
  changeXid          BigInt        @default(dbgenerated("((pg_current_xact_id())::text)::bigint")) @map("change_xid")

  subjectVoter     Voter?       @relation(fields: [subjectVoterId], references: [id], onDelete: Restrict)
  subjectHousehold Household?   @relation(fields: [subjectHouseholdId], references: [id], onDelete: Restrict)
  capturedBy       AppUser?     @relation("ConsentCapturedBy", fields: [capturedById], references: [id], onDelete: Restrict)
  withdrawnBy      AppUser?     @relation("ConsentWithdrawnBy", fields: [withdrawnById], references: [id], onDelete: Restrict)
  fieldValues      FieldValue[]
  locationOf       Household[]  @relation("HouseholdLocationConsent")

  @@index([subjectVoterId, purpose])
  @@index([subjectHouseholdId, purpose])
  @@index([changeXid])
  @@map("consent")
}

// ---------------------------------------------------------------------------
// Idempotency and audit
// ---------------------------------------------------------------------------

/// The stored response of a write made with an Idempotency-Key header, so a
/// retried request (e.g. an upload repeated after a lost connection) gets the
/// same response instead of being applied twice (plan §2).
model IdempotencyRecord {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  /// The Idempotency-Key header sent by the client.
  key         String
  /// SHA-256 of method + path + body; a reused key with a different request is rejected.
  requestHash String   @map("request_hash")
  statusCode  Int      @map("status_code")
  response    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  /// Records are kept long enough to cover offline phones retrying (cleanup job later).
  expiresAt   DateTime @map("expires_at") @db.Timestamptz

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_record")
}

enum AuditResult {
  success
  /// Refused by authorization (scope, role, suspended account, …).
  denied
  failure

  @@map("audit_result")
}

/// Append-only, hash-chained audit log (spec §14, plan §2). The database fills
/// seq, prev_hash and hash on insert, and refuses UPDATE, DELETE and TRUNCATE.
/// Personal data must never be written to metadata (the API redacts it, #34).
model AuditEvent {
  id           String      @id @default(uuid(7)) @db.Uuid
  /// Position in the chain; assigned by the database.
  seq          BigInt      @unique @default(autoincrement())
  /// Null for system events (imports running in a worker, scheduled jobs).
  actorId      String?     @map("actor_id") @db.Uuid
  sessionId    String?     @map("session_id") @db.Uuid
  /// e.g. "auth.login", "import.confirm", "visit.create", "field_value.write".
  action       String
  resourceType String      @map("resource_type")
  resourceId   String?     @map("resource_id")
  result       AuditResult
  /// Request ID from the X-Request-Id header, to join with the logs.
  requestId    String?     @map("request_id")
  at           DateTime    @default(now()) @db.Timestamptz
  metadata     Json        @default("{}")
  /// Hash of the previous event (null only for the first event).
  prevHash     String?     @map("prev_hash")
  /// SHA-256 over prev_hash and this event's contents; computed by the database.
  hash         String      @unique @default("pending")

  actor   AppUser? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([actorId, at])
  @@index([resourceType, resourceId])
  @@index([action, at])
  @@map("audit_event")
}

// ---------------------------------------------------------------------------
// Analytics (design §7, #102)
// ---------------------------------------------------------------------------

/// Per-node analytics. `own` holds what is counted at the node itself
/// (voters, households and visits at a station; a part's import quality);
/// `metrics` is the subtree total: own plus the children's totals. Raw,
/// additive counts only; ratios and medians are derived when read, and
/// small groups are suppressed by the API (never here).
model NodeStats {
  nodeId     String   @id @map("node_id") @db.Uuid
  programId  String   @map("program_id") @db.Uuid
  own        Json     @default("{}")
  metrics    Json     @default("{}")
  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz

  node GeographyNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@map("node_stats")
}

/// Nodes waiting for their stats (and their ancestors') to be refreshed.
/// A queue: written in the same transaction as the change, drained with
/// FOR UPDATE SKIP LOCKED.
model NodeStatsRequest {
  nodeId      String   @id @map("node_id") @db.Uuid
  requestedAt DateTime @default(now()) @map("requested_at") @db.Timestamptz

  node GeographyNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@map("node_stats_request")
}
