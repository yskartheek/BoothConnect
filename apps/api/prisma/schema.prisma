// BoothConnect database schema. Conventions (see apps/api/README.md):
// - IDs: UUIDv7, generated by Prisma in the app: `id String @id @default(uuid(7)) @db.Uuid`
// - Timestamps: `DateTime @db.Timestamptz`, always stored in UTC
// - Table and column names: snake_case via @@map / @map; model and field names: PascalCase / camelCase

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}
