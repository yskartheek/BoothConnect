// BoothConnect database schema. Conventions (see apps/api/README.md):
// - IDs: UUIDv7, generated by Prisma in the app: `id String @id @default(uuid(7)) @db.Uuid`
// - Timestamps: `DateTime @db.Timestamptz`, always stored in UTC
// - Table and column names: snake_case via @@map / @map; model and field names: PascalCase / camelCase

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  runtime         = "nodejs"
  // Partial unique indexes (e.g. top-level geography codes); generally available in Prisma 8.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Organization and election program
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  active
  suspended

  @@map("organization_status")
}

model Organization {
  id              String             @id @default(uuid(7)) @db.Uuid
  name            String
  status          OrganizationStatus @default(active)
  defaultLanguage String             @default("en") @map("default_language")
  /// Organization-wide policy settings (e.g. analytics threshold); validated by the API.
  policyConfig    Json               @default("{}") @map("policy_config")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  programs ElectionProgram[]
  users    AppUser[]

  @@map("organization")
}

enum ElectionProgramType {
  general_election
  by_election
  local_body_election
  campaign

  @@map("election_program_type")
}

enum ElectionProgramStatus {
  draft
  active
  closed
  archived

  @@map("election_program_status")
}

model ElectionProgram {
  id             String                @id @default(uuid(7)) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  name           String
  type           ElectionProgramType
  startDate      DateTime?             @map("start_date") @db.Date
  endDate        DateTime?             @map("end_date") @db.Date
  status         ElectionProgramStatus @default(draft)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  geographyNodes GeographyNode[]

  @@index([organizationId])
  @@map("election_program")
}

// ---------------------------------------------------------------------------
// Geography: State → PC → AC → Part → Polling Station
// (docs/design/voter-roll-pdf-import.md §2)
//
// Enforced by triggers in the migration SQL (Prisma can't express them):
// - a node's parent must be of the level directly above it (roots are states)
// - parent, type and program can't change after insert
// - geography_closure is filled automatically on insert
// ---------------------------------------------------------------------------

enum GeographyNodeType {
  state
  pc
  ac
  part
  polling_station

  @@map("geography_node_type")
}

model GeographyNode {
  id          String            @id @default(uuid(7)) @db.Uuid
  programId   String            @map("program_id") @db.Uuid
  parentId    String?           @map("parent_id") @db.Uuid
  type        GeographyNodeType
  /// Official number: state code (S29), PC 6, AC 40, part 408, auxiliary station 408A.
  code        String
  name        String
  /// Only for polling stations: an auxiliary station splitting its part.
  isAuxiliary Boolean           @default(false) @map("is_auxiliary")
  /// Reservation status, names by language; parts: sections, town, mandal, district, PIN;
  /// stations: address, station type, and for auxiliary stations the sections or serial range covered.
  metadata    Json              @default("{}")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  program         ElectionProgram    @relation(fields: [programId], references: [id], onDelete: Restrict)
  parent          GeographyNode?     @relation("GeographyTree", fields: [parentId], references: [id], onDelete: Restrict)
  children        GeographyNode[]    @relation("GeographyTree")
  ancestors       GeographyClosure[] @relation("ClosureDescendant")
  descendants     GeographyClosure[] @relation("ClosureAncestor")
  roleAssignments RoleAssignment[]

  @@unique([programId, parentId, code], map: "geography_node_sibling_code_key")
  // Top-level states have no parent, and NULLs never collide in a normal unique index.
  @@unique([programId, code], map: "geography_node_root_code_key", where: { parentId: null })
  @@index([parentId])
  @@index([programId, type])
  @@map("geography_node")
}

/// Every (ancestor, descendant) pair, including each node with itself at depth 0.
/// "All polling stations under AC 40" and "all ancestors of a station" are single queries.
model GeographyClosure {
  ancestorId   String @map("ancestor_id") @db.Uuid
  descendantId String @map("descendant_id") @db.Uuid
  depth        Int

  ancestor   GeographyNode @relation("ClosureAncestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant GeographyNode @relation("ClosureDescendant", fields: [descendantId], references: [id], onDelete: Cascade)

  @@id([ancestorId, descendantId])
  @@index([descendantId, depth])
  @@map("geography_closure")
}

// ---------------------------------------------------------------------------
// Users, sessions and role assignments
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  /// Loses access to every protected API immediately (spec §7.1).
  suspended

  @@map("user_status")
}

enum MfaState {
  /// MFA not set up. Admins and campaign managers must enrol before touching personal data.
  not_enrolled
  enrolled

  @@map("mfa_state")
}

model AppUser {
  id                String     @id @default(uuid(7)) @db.Uuid
  organizationId    String     @map("organization_id") @db.Uuid
  name              String
  /// E.164 format, e.g. +919876543210. Used for OTP sign-in, so unique.
  phone             String     @unique
  /// Stored lower-case.
  email             String?    @unique
  status            UserStatus @default(active)
  preferredLanguage String     @default("en") @map("preferred_language")
  mfaState          MfaState   @default(not_enrolled) @map("mfa_state")
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessions        Session[]
  roleAssignments RoleAssignment[] @relation("AssignedUser")
  grantedRoles    RoleAssignment[] @relation("GrantedBy")

  @@index([organizationId])
  @@map("app_user")
}

/// One signed-in device. Refresh tokens rotate on every use (plan §2): only the
/// hash of the current one is stored.
model Session {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  deviceId    String    @map("device_id")
  /// SHA-256 of the current refresh token.
  refreshHash String    @unique @map("refresh_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

enum Role {
  admin
  campaign_manager
  volunteer
  voter

  @@map("role")
}

/// A role on a geography node (and everything below it) for a time window.
/// Active at time T: valid_from <= T and (valid_until is null or valid_until > T).
model RoleAssignment {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  role            Role
  geographyNodeId String    @map("geography_node_id") @db.Uuid
  validFrom       DateTime  @default(now()) @map("valid_from") @db.Timestamptz
  validUntil      DateTime? @map("valid_until") @db.Timestamptz
  /// Null only for assignments created by the seed or bootstrap scripts.
  grantedById     String?   @map("granted_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user          AppUser       @relation("AssignedUser", fields: [userId], references: [id], onDelete: Cascade)
  geographyNode GeographyNode @relation(fields: [geographyNodeId], references: [id], onDelete: Restrict)
  grantedBy     AppUser?      @relation("GrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([userId, validFrom])
  @@index([geographyNodeId])
  @@map("role_assignment")
}
